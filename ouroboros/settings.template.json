{
  "_comment": "Настройки Ouroboros (засев — oil_ouroboros/bootstrap.py; значения ${…} — из .env). Ключи из _owner_keys — владельца: засев ставит их, а правку в UI Ouroboros не откатывает. Остальные — интеграция (шлюз LLM, MCP, пароль, бюджет): пишутся при каждом запуске. Почему так — docs/adr/0001-ouroboros-as-agent.md",
  "_owner_keys": [
    "OUROBOROS_MODEL_HEAVY", "OUROBOROS_MODEL_FALLBACKS", "OUROBOROS_MODEL_CONSCIOUSNESS", "OUROBOROS_MODEL_MAX_CONCURRENCY",
    "OUROBOROS_RUNTIME_MODE", "OUROBOROS_CONTEXT_MODE", "OUROBOROS_CONTEXT_MODE_AUTO_LOW", "OUROBOROS_SAFETY_MODE",
    "OUROBOROS_TASK_REVIEW_MODE", "OUROBOROS_REVIEW_ENFORCEMENT", "OUROBOROS_POST_TASK_EVOLUTION",
    "OUROBOROS_POST_TASK_EVOLUTION_BUDGET_USD", "OUROBOROS_CONSCIOUSNESS_DAILY_USD", "OUROBOROS_CONSCIOUSNESS_MAX_TASKS",
    "OUROBOROS_CONSCIOUSNESS_AUTONOMY", "OUROBOROS_ALLOW_MUTATIVE_SUBAGENTS", "OUROBOROS_MAX_ACTIVE_SUBAGENTS_PER_ROOT",
    "OUROBOROS_EFFORT_MIN", "OUROBOROS_EFFORT_TASK", "OUROBOROS_EFFORT_MAX", "OUROBOROS_MAX_ROUNDS",
    "OUROBOROS_TASK_IDLE_TIMEOUT_SEC", "OUROBOROS_MAX_WORKERS", "OUROBOROS_MAIN_WEB_SEARCH", "OUROBOROS_WEBSEARCH_BACKEND",
    "OUROBOROS_GC_RETENTION_DAYS", "OUROBOROS_UI_LANGUAGE"
  ],

  "OPENAI_COMPATIBLE_BASE_URL": "http://gateway:8030/api/v1",
  "OPENAI_COMPATIBLE_API_KEY": "${GATEWAY_TOKEN_OUROBOROS}",
  "OPENROUTER_API_KEY": "",
  "OUROBOROS_MODEL": "openai-compatible::${OUROBOROS_MODEL}",
  "OUROBOROS_MODEL_LIGHT": "openai-compatible::${OUROBOROS_MODEL_LIGHT}",
  "OUROBOROS_MODEL_HEAVY": "",
  "OUROBOROS_MODEL_FALLBACKS": "",
  "OUROBOROS_MODEL_CONSCIOUSNESS": "",
  "OUROBOROS_MODEL_MAX_CONCURRENCY": 3,

  "OUROBOROS_RUNTIME_MODE": "advanced",
  "OUROBOROS_CONTEXT_MODE": "low",
  "OUROBOROS_CONTEXT_MODE_AUTO_LOW": "false",
  "OUROBOROS_SAFETY_MODE": "off",
  "OUROBOROS_TASK_REVIEW_MODE": "off",
  "OUROBOROS_REVIEW_ENFORCEMENT": "advisory",
  "OUROBOROS_POST_TASK_EVOLUTION": "false",
  "OUROBOROS_POST_TASK_EVOLUTION_BUDGET_USD": "0",
  "OUROBOROS_CONSCIOUSNESS_DAILY_USD": "0",
  "OUROBOROS_CONSCIOUSNESS_MAX_TASKS": 0,
  "OUROBOROS_CONSCIOUSNESS_AUTONOMY": "act",
  "OUROBOROS_ALLOW_MUTATIVE_SUBAGENTS": "",
  "OUROBOROS_MAX_ACTIVE_SUBAGENTS_PER_ROOT": 6,

  "OUROBOROS_EFFORT_MIN": "low",
  "OUROBOROS_EFFORT_TASK": "low",
  "OUROBOROS_EFFORT_MAX": "medium",
  "OUROBOROS_MAX_ROUNDS": 10,
  "OUROBOROS_TASK_IDLE_TIMEOUT_SEC": 300,
  "OUROBOROS_MAX_WORKERS": 3,

  "TOTAL_BUDGET": ${OUROBOROS_TOTAL_BUDGET},
  "OUROBOROS_PER_TASK_COST_USD": ${OUROBOROS_PER_TASK_COST_USD},

  "OUROBOROS_MAIN_WEB_SEARCH": "off",
  "OUROBOROS_WEBSEARCH_BACKEND": "ddgs",

  "MCP_ENABLED": true,
  "MCP_TOOL_TIMEOUT_SEC": 180,
  "MCP_SERVERS": [
    {
      "id": "oil",
      "name": "oil-tools (LangGraph)",
      "enabled": true,
      "transport": "streamable_http",
      "url": "http://tools:8000/mcp",
      "auth_token": "Bearer ${MCP_TOKEN}",
      "allowed_tools": ["research", "search_reports", "search_web", "forecast_price", "supply_shock_scenario",
                        "price_history", "price_quote", "verify_answer", "list_reports"]
    }
  ],

  "OUROBOROS_NETWORK_PASSWORD": "${OUROBOROS_PASSWORD}",
  "OUROBOROS_SERVER_HOST": "0.0.0.0",
  "OUROBOROS_GC_RETENTION_DAYS": 14,
  "OUROBOROS_UI_LANGUAGE": "",
  "OUROBOROS_ONBOARDING_COMPLETED_AT": "${NOW}"
}
