# LLM-профиль openrouter: модели OpenRouter через шлюз (ключ OPENROUTER_API_KEY знает только шлюз).
# Агент — claude-haiku-5.5 (держит протокол завершения хода Ouroboros), субагенты — модель из config/current/llm.yaml.
OUROBOROS_MODEL=anthropic/claude-haiku-5.5
OUROBOROS_MODEL_LIGHT=deepseek/deepseek-v4.1-flash
LLM_MODEL_SUBAGENT=
