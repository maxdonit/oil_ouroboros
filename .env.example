# ---------------------------------------------------------------------------------------------------------------
# «Нефтегазовый аналитик на Ouroboros» — шаблон настроек окружения (.env в git не попадает).
#   python scripts/init_env.py      # .env из шаблона: внутренние токены генерируются сами
# Для запуска достаточно вписать GIGACHAT_CREDENTIALS (и по желанию TAVILY_API_KEY, TELEGRAM_BOT_TOKEN), затем:
#   docker compose up -d       # ядро + профили по умолчанию: owner (канал владельца) и gigachat (модели GigaChat)
#
# Здесь — инфраструктура: ключи, деньги, модели, состав сервисов, сеть. Поведение инструментов (промпты, поиск,
# веб-политика, прогноз) — config/; роль и регламент агента — его память ouroboros/memory/. Остальные ~40 параметров
# (интервалы наблюдателя и цен, кэш веба, модели эмбеддингов, внутренние адреса) имеют значения по умолчанию — список
# с описаниями: docs/guide/parameters.md и консоль → «Параметры».
# ---------------------------------------------------------------------------------------------------------------

# === 1. Впишите сами ============================================================================================
# LLM-профиль gigachat (по умолчанию): ключ авторизации GigaChat API (developers.sber.ru) — его знает только gpt2giga
GIGACHAT_CREDENTIALS=
# LLM-профиль openrouter (python scripts/llm_profile.py openrouter): ключ OpenRouter — его знает только шлюз (gateway)
OPENROUTER_API_KEY=
# веб-поиск: Tavily, если есть ключ, иначе Brave, иначе DuckDuckGo (без ключа)
TAVILY_API_KEY=
BRAVE_API_KEY=
# профиль owner: бот Telegram владельца (@BotFather; засев кладёт токен в настройки Ouroboros один раз). Без него
# канал владельца — только собственный UI Ouroboros
TELEGRAM_BOT_TOKEN=
# пароль собственного UI Ouroboros (профиль owner, порт 38630) и его API; консоль — без пароля. UI виден в сети хоста
# (OILO_BIND=0.0.0.0): поменяйте пароль и не пробрасывайте порт 38630 в интернет — у агента там shell
OUROBOROS_PASSWORD=ouroboros

# === 2. Заполняет scripts/init_env.py ===========================================================================
# внутренние токены: у каждого сервиса только свой (docker-compose.yml обнуляет чужие)
GATEWAY_TOKEN_OUROBOROS=
GATEWAY_TOKEN_TOOLS=
GATEWAY_TOKEN_CONSOLE=
TOOLS_API_TOKEN=
MCP_TOKEN=
# шлюз ↔ gpt2giga (LLM-профиль gigachat)
GPT2GIGA_API_KEY=

# === 3. Деньги и модели =========================================================================================
# жёсткий лимит денег на ВСЕ вызовы LLM системы (агент + инструменты + eval), USD; при превышении шлюз отвечает 402.
# GigaChat Freemium бесплатен: шлюз пишет $0, расход виден в токенах
GATEWAY_BUDGET_USD=5
# лимит Ouroboros за всё время и потолок на одну задачу, USD (засев переписывает их из .env при каждом запуске)
OUROBOROS_TOTAL_BUDGET=4
OUROBOROS_PER_TASK_COST_USD=0.3
# LLM-профиль — меняет модели ниже и COMPOSE_PROFILES: python scripts/llm_profile.py gigachat | openrouter
LLM_PROFILE=gigachat
# модель агента (держит протокол Ouroboros: завершение хода finish_task) и лёгкая — его служебные вызовы
OUROBOROS_MODEL=GigaChat-3-Ultra
OUROBOROS_MODEL_LIGHT=GigaChat-2
# модель инструментов поверх config/current/llm.yaml (пусто — из каталога)
LLM_MODEL_SUBAGENT=GigaChat-3-Ultra
# профиль gigachat: scope ключа (GIGACHAT_API_PERS — физлица, Freemium)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# === 4. Состав сервисов и сеть ==================================================================================
# профили: owner — канал владельца (собственный UI Ouroboros, Telegram, утренняя сводка); gigachat — прокси gpt2giga
# (его ставит и убирает llm_profile.py). Только ядро — пусто, но на LLM-профиле gigachat без gpt2giga у шлюза нет
# модели: сначала python scripts/llm_profile.py openrouter
COMPOSE_PROFILES=owner,gigachat
# хост без прямого выхода в интернет: docker-compose.yml:deploy/compose/proxy.yml (и UPSTREAM_PROXY ниже)
COMPOSE_FILE=docker-compose.yml
# консоль и UI Ouroboros на хосте: адрес и порты. 0.0.0.0 — все адреса хоста: консоль (без пароля) и UI Ouroboros
# (по паролю) видны с других машин сети и через проброс порта роутера; 127.0.0.1 — только эта машина
OILO_BIND=0.0.0.0
OILO_PORT=38620
OUROBOROS_UI_PORT=38630
# профиль owner: куда пускает egress (выход агента наружу)
EGRESS_ALLOW=api.telegram.org
# хост за прокси организации (deploy/compose/proxy.yml): OUTBOUND_PROXY=http://proxy:3128, адрес прокси host:port и,
# если он доступен только из другой docker-сети, её имя
OUTBOUND_PROXY=
UPSTREAM_PROXY=
UPSTREAM_PROXY_NETWORK=
# корневой сертификат, если прокси подменяет TLS: путь внутри контейнеров (файл смонтируйте сами)
CA_BUNDLE=
# ядра кодировщика и сервиса инструментов (не больше, чем у хоста)
ENCODER_THREADS=4
TOOLS_CPUS=4

# === 5. Цель деплоя: только scripts/deploy.py, на сервер не переносится =========================================
DEPLOY_SSH=
DEPLOY_DIR=/opt/oil-ouroboros
DEPLOY_KEY=
